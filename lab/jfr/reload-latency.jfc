<?xml version="1.0" encoding="UTF-8"?>
<configuration version="2.0" label="CubicChunks reload latency" description="Java 26 diagnostic method traces; timings include tracing overhead" provider="CubicChunks Lab">
  <!-- AsyncCubeIOProvider is omitted: Java 26 instrumentation cannot resolve its Chunk frame under this loader. Use future parks plus reader/completion events. -->
  <event name="jdk.MethodTrace">
    <setting name="enabled">true</setting>
    <setting name="threshold">0 ns</setting>
    <setting name="stackTrace">true</setting>
    <setting name="filter">net.minecraft.server.MinecraftServer::func_71217_p;net.minecraft.world.WorldServer::func_72835_b;io.github.opencubicchunks.cubicchunks.core.server.PlayerCubeMap::func_72693_b;io.github.opencubicchunks.cubicchunks.core.server.CubeProviderServer::func_73156_b;io.github.opencubicchunks.cubicchunks.core.server.CubeProviderServer::getCubeNow;io.github.opencubicchunks.cubicchunks.core.server.CubeProviderServer::generateCube;io.github.opencubicchunks.cubicchunks.core.server.CubeProviderServer::calculateDiffuseSkylight;io.github.opencubicchunks.cubicchunks.core.server.CubeProviderServer::onCubeLoaded;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncWorldIOExecutor::queueCubeLoad;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncWorldIOExecutor::syncCubeLoad;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncWorldIOExecutor::tick;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncColumnIOProvider::run;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncTaskCompletion::complete;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncIOProvider::finishAsync;io.github.opencubicchunks.cubicchunks.core.server.chunkio.async.forge.AsyncIOProvider::runCallbacks;io.github.opencubicchunks.cubicchunks.core.server.chunkio.RegionCubeStorage::readCube;io.github.opencubicchunks.cubicchunks.core.server.chunkio.RegionCubeStorage::readColumn;io.github.opencubicchunks.cubicchunks.core.server.chunkio.region.ShadowPagingRegion::readValue;io.github.opencubicchunks.cubicchunks.core.server.chunkio.IONbtReader::readCubeAsyncPart;io.github.opencubicchunks.cubicchunks.core.server.chunkio.IONbtReader::readCubeSyncPart;io.github.opencubicchunks.cubicchunks.core.world.cube.Cube::onLoad;io.github.opencubicchunks.cubicchunks.lab.LabJob::tick;io.github.opencubicchunks.cubicchunks.api.util.XYZMap::collapseBucket</setting>
  </event>
  <event name="jdk.ThreadPark"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting><setting name="stackTrace">true</setting></event>
  <event name="jdk.ThreadSleep"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting><setting name="stackTrace">true</setting></event>
  <event name="jdk.JavaMonitorEnter"><setting name="enabled">true</setting><setting name="threshold">1 ms</setting><setting name="stackTrace">true</setting></event>
  <event name="jdk.JavaMonitorWait"><setting name="enabled">true</setting><setting name="threshold">1 ms</setting><setting name="stackTrace">true</setting></event>
  <event name="jdk.ExecutionSample"><setting name="enabled">true</setting><setting name="period">10 ms</setting></event>
  <event name="jdk.GCPhasePause"><setting name="enabled">true</setting></event>
  <event name="jdk.GarbageCollection"><setting name="enabled">true</setting></event>
  <event name="jdk.FileRead"><setting name="enabled">true</setting><setting name="threshold">0 ns</setting><setting name="stackTrace">true</setting></event>
  <event name="jdk.Compilation"><setting name="enabled">true</setting><setting name="threshold">10 ms</setting></event>
  <event name="jdk.SafepointBegin"><setting name="enabled">true</setting><setting name="threshold">1 ms</setting></event>
</configuration>
